        else if (estadoAtual == GAME_OVER)
        {
            ClearBackground((Color){15, 10, 30, 255});
            DrawText("GAME OVER",
                     220, 90, 58, RED);
            DrawText(TextFormat("Pontuacao: %i",    pontuacao),   258, 185, 28, WHITE);
            DrawText(TextFormat("Onda chegou: %i",  onda),        258, 223, 24, (Color){255, 200, 80, 255});
            DrawText(TextFormat("Capturas: %i",     fantasmasCpt),258, 257, 24, (Color){200, 160, 255, 255});
            DrawText(TextFormat("Tempo: %.1fs",     tempo),       258, 289, 24, LIGHTGRAY);
            DrawText("R  ->  Reiniciar", 270, 345, 24, WHITE);
            DrawText("M  ->  Menu",      270, 383, 24, LIGHTGRAY);
        }

        EndDrawing();

    } // fim do while

    CloseWindow();
    return 0;
}
