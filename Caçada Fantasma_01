#include "raylib.h"
#include <stdbool.h>
#include <math.h>

// =========================================
// ESTADOS DO JOGO
// =========================================

typedef enum GameState
{
    MENU,
    GAME,
    PAUSE,
    INSTRUCTIONS,
    GAME_OVER,
    WIN
} GameState;

// =========================================
// CONSTANTES
// =========================================

#define MAX_FANTASMAS_BASE  5
#define MAX_FANTASMAS       12
#define MAX_CHEFOES         10
#define MAX_PARTICULAS      200
#define MAX_PILARES         6
#define PLASMA_CARGA_MAX    20
#define CHEFAO_VIDA_MAX     2

#define LARGURA_TELA        800
#define ALTURA_TELA         500
#define ALTURA_HUD          70

#define AREA_Y_MIN          ALTURA_HUD
#define AREA_Y_MAX          (ALTURA_TELA - 40)
#define AREA_X_MIN          0
#define AREA_X_MAX          (LARGURA_TELA - 40)

#define RAIO_FUGA           120.0f
#define RAIO_PORTAL         18.0f
#define COOLDOWN_PORTAL     2.0f

// =========================================
// STRUCTS
// =========================================

typedef struct Particula
{
    Vector2 posicao;
    Vector2 velocidade;
    float   tamanho;
    float   tempoVida;
    float   tempoVidaMax;
    bool    ativa;
    Color   cor;
} Particula;

typedef struct PlasmaBall
{
    Vector2 posicao;
    Vector2 direcao;
    float   velocidade;
    bool    ativa;
} PlasmaBall;

typedef struct Pilar
{
    Rectangle rect;
} Pilar;

// =========================================
// FUNCOES AUXILIARES
// =========================================

void CriarExplosao(Particula p[], Vector2 o, Color c1, Color c2, int n)
{
    int k = 0;
    for (int i = 0; i < MAX_PARTICULAS && k < n; i++)
    {
        if (p[i].ativa) continue;
        p[i].ativa        = true;
        p[i].posicao      = o;
        p[i].velocidade.x = GetRandomValue(-300, 300) / 100.0f;
        p[i].velocidade.y = GetRandomValue(-300, 300) / 100.0f;
        p[i].tamanho      = GetRandomValue(3, 9);
        p[i].tempoVida    = GetRandomValue(40, 80) / 100.0f;
        p[i].tempoVidaMax = p[i].tempoVida;
        p[i].cor          = (k % 2 == 0) ? c1 : c2;
        k++;
    }
}

void CriarTrilha(Particula p[], Vector2 o)
{
    for (int i = 0; i < MAX_PARTICULAS; i++)
    {
        if (p[i].ativa) continue;
        p[i].ativa        = true;
        p[i].posicao      = o;
        p[i].velocidade.x = GetRandomValue(-60, 60) / 100.0f;
        p[i].velocidade.y = GetRandomValue(-60, 60) / 100.0f;
        p[i].tamanho      = GetRandomValue(2, 5);
        p[i].tempoVida    = 0.18f;
        p[i].tempoVidaMax = 0.18f;
        p[i].cor          = (Color){80, 220, 255, 255};
        break;
    }
}

bool ColideComPilar(Rectangle r, Pilar pilares[], int total)
{
    for (int i = 0; i < total; i++)
        if (CheckCollisionRecs(r, pilares[i].rect)) return true;
    return false;
}

Vector2 ResolverColisaoPilar(Vector2 pos, float raio, Pilar pilares[], int total)
{
    for (int i = 0; i < total; i++)
    {
        Rectangle r  = pilares[i].rect;
        float cx     = r.x + r.width  / 2.0f;
        float cy     = r.y + r.height / 2.0f;
        float dx     = pos.x - cx;
        float dy     = pos.y - cy;
        float sobreX = (r.width  / 2.0f + raio) - fabsf(dx);
        float sobreY = (r.height / 2.0f + raio) - fabsf(dy);

        if (sobreX > 0 && sobreY > 0)
        {
            if (sobreX < sobreY)
                pos.x += (dx > 0) ? sobreX : -sobreX;
            else
                pos.y += (dy > 0) ? sobreY : -sobreY;
        }
    }
    return pos;
}

// Conta quantos fantasmas ainda estao vivos na onda
// FIX: substitui a lambda C++ por uma funcao auxiliar em C puro
int ContarVivos(bool fantasmaAtivo[], int total)
{
    int vivos = 0;
    for (int i = 0; i < total; i++)
        if (fantasmaAtivo[i]) vivos++;
    return vivos;
}

// =========================================
// FUNCAO DE RESET COMPLETO
// FIX: removido parametro `chefao_ptr` que era passado por valor e nunca usado
// =========================================

void ResetarJogo(
    Vector2    *jogador,
    int        *pontuacao,
    int        *vida,
    float      *tempo,
    int        *fantasmasCpt,
    int        *plasmaCarga,
    bool       *plasmaCarregado,
    PlasmaBall *plasma,
    bool       *chefaoAtivo,
    int        *chefaoVida,
    float      *chefaoTimer,
    float      *chefaoBob,
    float      *velChefao,
    int        *quantidadeChefoes,
    bool        chefaoExtraAtivo[],
    int         chefaoExtraVida[],
    float       chefaoExtraTimer[],
    Vector2     fantasmas[],
    bool        fantasmaAtivo[],
    int        *numFantasmasOnda,
    Particula   particulas[],
    int        *onda,
    float      *portalTimer
)
{
    *jogador           = (Vector2){400, 260};
    *pontuacao         = 0;
    *vida              = 100;
    *tempo             = 0.0f;
    *fantasmasCpt      = 0;
    *plasmaCarga       = 0;
    *plasmaCarregado   = false;
    plasma->ativa      = false;
    *chefaoAtivo       = true;
    *chefaoVida        = CHEFAO_VIDA_MAX;
    *chefaoTimer       = 0.0f;
    *chefaoBob         = 0.0f;
    *velChefao         = 1.2f;
    *quantidadeChefoes = 0;
    *onda              = 1;
    *numFantasmasOnda  = MAX_FANTASMAS_BASE;
    *portalTimer       = 0.0f;

    for (int i = 0; i < MAX_CHEFOES; i++)
    {
        chefaoExtraAtivo[i] = false;
        chefaoExtraVida[i]  = CHEFAO_VIDA_MAX;
        chefaoExtraTimer[i] = 0.0f;
    }
    for (int i = 0; i < MAX_FANTASMAS; i++)
    {
        fantasmaAtivo[i] = (i < MAX_FANTASMAS_BASE);
        fantasmas[i]     = (Vector2){100.0f + (i % 5) * 130.0f, 150.0f};
    }
    for (int i = 0; i < MAX_PARTICULAS; i++)
        particulas[i].ativa = false;
}

// =========================================
// MAIN
// =========================================

int main(void)
{
    InitWindow(LARGURA_TELA, ALTURA_TELA, "Cacada Fantasma");
    SetTargetFPS(60);

    GameState estadoAtual = MENU;

    // ---- Jogador ----
    Vector2 jogador   = { 400, 260 };
    float velocidade  = 4.0f;

    // ---- Ondas ----
    int onda             = 1;
    int numFantasmasOnda = MAX_FANTASMAS_BASE;

    // ---- Mini fantasmas ----
    float   velocidadeFantasma = 2.2f;
    Vector2 fantasmas[MAX_FANTASMAS];
    bool    fantasmaAtivo[MAX_FANTASMAS];

    for (int i = 0; i < MAX_FANTASMAS; i++)
    {
        fantasmaAtivo[i] = (i < numFantasmasOnda);
        fantasmas[i]     = (Vector2){100.0f + (i % 5) * 130.0f, 150.0f};
    }

    // ---- Fantasma isca (dourado) ----
    Vector2 fantasmaIsca      = { 600, 300 };
    bool    fantasmaIscaAtivo = false;
    float   fantasmaIscaTimer = 8.0f;

    // ---- Chefao principal ----
    Vector2 chefao      = { 100, 420 };
    bool    chefaoAtivo = true;
    int     chefaoVida  = CHEFAO_VIDA_MAX;
    float   velChefao   = 1.2f;
    float   chefaoTimer = 0.0f;
    float   chefaoBob   = 0.0f;

    // ---- Chefoes extras ----
    Vector2 chefoes[MAX_CHEFOES];
    bool    chefaoExtraAtivo[MAX_CHEFOES];
    int     chefaoExtraVida[MAX_CHEFOES];
    float   chefaoExtraTimer[MAX_CHEFOES];
    int     quantidadeChefoes = 0;

    for (int i = 0; i < MAX_CHEFOES; i++)
    {
        chefaoExtraAtivo[i] = false;
        chefaoExtraVida[i]  = CHEFAO_VIDA_MAX;
        chefaoExtraTimer[i] = 0.0f;
    }

    // ---- Plasma ----
    int        plasmaCarga     = 0;
    bool       plasmaCarregado = false;
    PlasmaBall plasma          = { {0,0}, {0,0}, 7.0f, false };

    // ---- Particulas ----
    Particula particulas[MAX_PARTICULAS] = { 0 };

    // ---- Pilares fixos ----
    Pilar pilares[MAX_PILARES] =
    {
        { { 160, 130, 30, 90 } },
        { { 610, 130, 30, 90 } },
        { { 350, 200, 30, 80 } },
        { { 100, 350, 90, 25 } },
        { { 610, 350, 90, 25 } },
        { { 350, 390, 80, 25 } },
    };

    // ---- Portais ----
    Vector2 portalA     = { 60,  280 };
    Vector2 portalB     = { 720, 280 };
    float   portalTimer = 0.0f;
    float   portalBob   = 0.0f;

    // ---- HUD ----
    int   pontuacao    = 0;
    int   vida         = 100;
    float tempo        = 0.0f;
    int   fantasmasCpt = 0;

    // =========================================
    // LOOP PRINCIPAL
    // =========================================

    while (!WindowShouldClose())
    {
        float dt = GetFrameTime();

        // =====================================
        // UPDATE
        // =====================================

        if (estadoAtual == MENU)
        {
            if (IsKeyPressed(KEY_ENTER))  estadoAtual = GAME;
            if (IsKeyPressed(KEY_I))      estadoAtual = INSTRUCTIONS;
            if (IsKeyPressed(KEY_ESCAPE)) break;
        }

        else if (estadoAtual == INSTRUCTIONS)
        {
            if (IsKeyPressed(KEY_BACKSPACE)) estadoAtual = MENU;
        }

        else if (estadoAtual == PAUSE)
        {
            if (IsKeyPressed(KEY_P) || IsKeyPressed(KEY_ESCAPE))
                estadoAtual = GAME;
        }

        else if (estadoAtual == WIN || estadoAtual == GAME_OVER)
        {
            if (IsKeyPressed(KEY_R))
            {
                // FIX: removido `chefao` do ResetarJogo (era passado por valor sem uso)
                ResetarJogo(
                    &jogador, &pontuacao, &vida, &tempo,
                    &fantasmasCpt, &plasmaCarga, &plasmaCarregado,
                    &plasma, &chefaoAtivo, &chefaoVida,
                    &chefaoTimer, &chefaoBob, &velChefao,
                    &quantidadeChefoes, chefaoExtraAtivo,
                    chefaoExtraVida, chefaoExtraTimer,
                    fantasmas, fantasmaAtivo, &numFantasmasOnda,
                    particulas, &onda, &portalTimer
                );
                chefao            = (Vector2){100, 420};
                fantasmaIscaAtivo = false;
                fantasmaIscaTimer = 8.0f;
                estadoAtual       = GAME;
            }
            if (IsKeyPressed(KEY_M))
            {
                ResetarJogo(
                    &jogador, &pontuacao, &vida, &tempo,
                    &fantasmasCpt, &plasmaCarga, &plasmaCarregado,
                    &plasma, &chefaoAtivo, &chefaoVida,
                    &chefaoTimer, &chefaoBob, &velChefao,
                    &quantidadeChefoes, chefaoExtraAtivo,
                    chefaoExtraVida, chefaoExtraTimer,
                    fantasmas, fantasmaAtivo, &numFantasmasOnda,
                    particulas, &onda, &portalTimer
                );
                chefao            = (Vector2){100, 420};
                fantasmaIscaAtivo = false;
                fantasmaIscaTimer = 8.0f;
                estadoAtual       = MENU;
            }
        }

        else if (estadoAtual == GAME)
        {
            tempo     += dt;
            chefaoBob += dt * 3.0f;
            portalBob += dt * 2.0f;
            if (portalTimer > 0) portalTimer -= dt;

            Vector2 centroJogador = { jogador.x + 20, jogador.y + 25 };

            // -- PAUSE --
            // FIX: removido `goto draw` — pause agora e tratado normalmente
            // sem pular o bloco de desenho via goto, evitando comportamento
            // indefinido e problemas de variaveis nao inicializadas
            if (IsKeyPressed(KEY_P))
            {
                estadoAtual = PAUSE;
            }
            else
            {
                // --- Movimento do jogador ---
                Vector2 novaPos = jogador;
                if (IsKeyDown(KEY_RIGHT)) novaPos.x += velocidade;
                if (IsKeyDown(KEY_LEFT))  novaPos.x -= velocidade;
                if (IsKeyDown(KEY_UP))    novaPos.y -= velocidade;
                if (IsKeyDown(KEY_DOWN))  novaPos.y += velocidade;

                novaPos = ResolverColisaoPilar(novaPos, 20, pilares, MAX_PILARES);

                if (novaPos.x < AREA_X_MIN) novaPos.x = AREA_X_MIN;
                if (novaPos.x > AREA_X_MAX) novaPos.x = AREA_X_MAX;
                if (novaPos.y < AREA_Y_MIN) novaPos.y = AREA_Y_MIN;
                if (novaPos.y > AREA_Y_MAX) novaPos.y = AREA_Y_MAX;

                jogador       = novaPos;
                centroJogador = (Vector2){ jogador.x + 20, jogador.y + 25 };

                // --- Portais ---
                float dPA = sqrtf(
                    (centroJogador.x - portalA.x) * (centroJogador.x - portalA.x) +
                    (centroJogador.y - portalA.y) * (centroJogador.y - portalA.y));
                float dPB = sqrtf(
                    (centroJogador.x - portalB.x) * (centroJogador.x - portalB.x) +
                    (centroJogador.y - portalB.y) * (centroJogador.y - portalB.y));

                if (portalTimer <= 0.0f)
                {
                    if (dPA < RAIO_PORTAL)
                    {
                        jogador.x   = portalB.x - 20;
                        jogador.y   = portalB.y - 25;
                        portalTimer = COOLDOWN_PORTAL;
                        CriarExplosao(particulas, portalB,
                                      (Color){0,200,255,255}, (Color){180,0,255,255}, 20);
                    }
                    else if (dPB < RAIO_PORTAL)
                    {
                        jogador.x   = portalA.x - 20;
                        jogador.y   = portalA.y - 25;
                        portalTimer = COOLDOWN_PORTAL;
                        CriarExplosao(particulas, portalA,
                                      (Color){0,200,255,255}, (Color){180,0,255,255}, 20);
                    }
                }

                // --- Disparo de plasma ---
                if (IsKeyPressed(KEY_SPACE) && plasmaCarregado && !plasma.ativa)
                {
                    plasma.ativa   = true;
                    plasma.posicao = centroJogador;

                    float menorDist = 999999.0f;
                    Vector2 alvo    = { centroJogador.x + 1.0f, centroJogador.y };

                    if (chefaoAtivo)
                    {
                        float dx  = chefao.x - centroJogador.x;
                        float dy  = chefao.y - centroJogador.y;
                        menorDist = sqrtf(dx*dx + dy*dy);
                        alvo      = chefao;
                    }
                    for (int i = 0; i < quantidadeChefoes; i++)
                    {
                        if (!chefaoExtraAtivo[i]) continue;
                        float dx = chefoes[i].x - centroJogador.x;
                        float dy = chefoes[i].y - centroJogador.y;
                        float d  = sqrtf(dx*dx + dy*dy);
                        if (d < menorDist) { menorDist = d; alvo = chefoes[i]; }
                    }

                    float dx = alvo.x - centroJogador.x;
                    float dy = alvo.y - centroJogador.y;
                    float d  = sqrtf(dx*dx + dy*dy);
                    if (d < 0.5f) { dx = 1.0f; d = 1.0f; }
                    plasma.direcao.x = dx / d;
                    plasma.direcao.y = dy / d;
                    plasmaCarregado  = false;
                    plasmaCarga      = 0;
                }

                // --- Atualiza plasma ---
                if (plasma.ativa)
                {
                    plasma.posicao.x += plasma.direcao.x * plasma.velocidade;
                    plasma.posicao.y += plasma.direcao.y * plasma.velocidade;
                    CriarTrilha(particulas, plasma.posicao);

                    Rectangle rPlasma = {
                        plasma.posicao.x - 10,
                        plasma.posicao.y - 10,
                        20, 20
                    };
                    if (ColideComPilar(rPlasma, pilares, MAX_PILARES))
                    {
                        CriarExplosao(particulas, plasma.posicao,
                                      (Color){80,220,255,255}, WHITE, 12);
                        plasma.ativa = false;
                    }

                    if (plasma.posicao.x < 0 || plasma.posicao.x > LARGURA_TELA ||
                        plasma.posicao.y < 0 || plasma.posicao.y > ALTURA_TELA)
                        plasma.ativa = false;

                    if (plasma.ativa && chefaoAtivo)
                    {
                        float dx = plasma.posicao.x - chefao.x;
                        float dy = plasma.posicao.y - chefao.y;
                        if (sqrtf(dx*dx + dy*dy) < 28)
                        {
                            chefaoVida--;
                            CriarExplosao(particulas, chefao,
                                          (Color){255,80,0,255},
                                          (Color){80,200,255,255}, 40);
                            plasma.ativa = false;
                            if (chefaoVida <= 0)
                            {
                                chefaoAtivo = false;
                                CriarExplosao(particulas, chefao,
                                              (Color){255,200,0,255},
                                              (Color){255,80,0,255}, 80);
                            }
                        }
                    }

                    for (int i = 0; i < quantidadeChefoes; i++)
                    {
                        if (!chefaoExtraAtivo[i] || !plasma.ativa) continue;
                        float dx = plasma.posicao.x - chefoes[i].x;
                        float dy = plasma.posicao.y - chefoes[i].y;
                        if (sqrtf(dx*dx + dy*dy) < 22)
                        {
                            chefaoExtraVida[i]--;
                            CriarExplosao(particulas, chefoes[i],
                                          (Color){255,80,0,255},
                                          (Color){80,200,255,255}, 30);
                            plasma.ativa = false;
                            if (chefaoExtraVida[i] <= 0)
                            {
                                chefaoExtraAtivo[i] = false;
                                CriarExplosao(particulas, chefoes[i],
                                              (Color){255,200,0,255},
                                              (Color){255,80,0,255}, 60);
                            }
                        }
                    }
                }

                // --- Atualiza particulas ---
                for (int i = 0; i < MAX_PARTICULAS; i++)
                {
                    if (!particulas[i].ativa) continue;
                    particulas[i].posicao.x += particulas[i].velocidade.x * 100 * dt;
                    particulas[i].posicao.y += particulas[i].velocidade.y * 100 * dt;
                    particulas[i].tempoVida -= dt;
                    particulas[i].tamanho   -= dt * 4;
                    if (particulas[i].tempoVida <= 0 || particulas[i].tamanho <= 0)
                        particulas[i].ativa = false;
                }

                // --- Mini fantasmas: fogem ---
                for (int i = 0; i < numFantasmasOnda; i++)
                {
                    if (!fantasmaAtivo[i]) continue;

                    float dx   = fantasmas[i].x - centroJogador.x;
                    float dy   = fantasmas[i].y - centroJogador.y;
                    float dist = sqrtf(dx*dx + dy*dy);

                    if (dist < RAIO_FUGA && dist > 0.5f)
                    {
                        Vector2 novaF = {
                            fantasmas[i].x + (dx / dist) * velocidadeFantasma,
                            fantasmas[i].y + (dy / dist) * velocidadeFantasma
                        };
                        novaF        = ResolverColisaoPilar(novaF, 12, pilares, MAX_PILARES);
                        fantasmas[i] = novaF;
                    }

                    if (fantasmas[i].x < 15)                fantasmas[i].x = 15;
                    if (fantasmas[i].x > LARGURA_TELA - 15) fantasmas[i].x = LARGURA_TELA - 15;
                    if (fantasmas[i].y < AREA_Y_MIN + 15)   fantasmas[i].y = AREA_Y_MIN + 15;
                    if (fantasmas[i].y > ALTURA_TELA - 15)  fantasmas[i].y = ALTURA_TELA - 15;
                }

                // --- Fantasma isca (onda >= 2) ---
                if (onda >= 2)
                {
                    if (!fantasmaIscaAtivo)
                    {
                        fantasmaIscaTimer -= dt;
                        if (fantasmaIscaTimer <= 0.0f)
                        {
                            fantasmaIscaAtivo = true;
                            fantasmaIsca      = (Vector2){
                                (float)GetRandomValue(80, 700),
                                (float)GetRandomValue(AREA_Y_MIN + 30, ALTURA_TELA - 50)
                            };
                            fantasmaIscaTimer = 10.0f + (float)GetRandomValue(0, 8);
                        }
                    }
                    else
                    {
                        float dx      = fantasmaIsca.x - centroJogador.x;
                        float dy      = fantasmaIsca.y - centroJogador.y;
                        float dist    = sqrtf(dx*dx + dy*dy);
                        float velIsca = velocidadeFantasma * 3.2f;

                        if (dist < RAIO_FUGA * 1.5f && dist > 0.5f)
                        {
                            Vector2 novaI = {
                                fantasmaIsca.x + (dx / dist) * velIsca,
                                fantasmaIsca.y + (dy / dist) * velIsca
                            };
                            novaI        = ResolverColisaoPilar(novaI, 12, pilares, MAX_PILARES);
                            fantasmaIsca = novaI;
                        }

                        if (fantasmaIsca.x < 15)                fantasmaIsca.x = 15;
                        if (fantasmaIsca.x > LARGURA_TELA - 15) fantasmaIsca.x = LARGURA_TELA - 15;
                        if (fantasmaIsca.y < AREA_Y_MIN + 15)   fantasmaIsca.y = AREA_Y_MIN + 15;
                        if (fantasmaIsca.y > ALTURA_TELA - 15)  fantasmaIsca.y = ALTURA_TELA - 15;

                        Rectangle rJ = { jogador.x, jogador.y, 40, 40 };
                        Rectangle rI = { fantasmaIsca.x - 12, fantasmaIsca.y - 12, 24, 24 };

                        if (CheckCollisionRecs(rJ, rI))
                        {
                            fantasmaIscaAtivo = false;
                            fantasmaIscaTimer = 10.0f + (float)GetRandomValue(0, 8);
                            pontuacao        += 50;
                            fantasmasCpt     += 1;
                            if (!plasmaCarregado)
                            {
                                plasmaCarga += 3;
                                if (plasmaCarga >= PLASMA_CARGA_MAX) plasmaCarregado = true;
                            }
                            CriarExplosao(particulas, fantasmaIsca, GOLD, YELLOW, 25);
                        }
                    }
                }

                // --- Chefao principal persegue ---
                velChefao = 1.2f + (float)pontuacao * 0.003f;

                if (chefaoAtivo)
                {
                    Vector2 novaC = chefao;
                    if (chefao.x < centroJogador.x) novaC.x += velChefao;
                    if (chefao.x > centroJogador.x) novaC.x -= velChefao;
                    if (chefao.y < centroJogador.y) novaC.y += velChefao;
                    if (chefao.y > centroJogador.y) novaC.y -= velChefao;

                    novaC = ResolverColisaoPilar(novaC, 26, pilares, MAX_PILARES);

                    if (novaC.x < 25)                novaC.x = 25;
                    if (novaC.x > LARGURA_TELA - 25) novaC.x = LARGURA_TELA - 25;
                    if (novaC.y < AREA_Y_MIN + 25)   novaC.y = AREA_Y_MIN + 25;
                    if (novaC.y > ALTURA_TELA - 25)  novaC.y = ALTURA_TELA - 25;
                    chefao = novaC;

                    chefaoTimer -= dt;
                    Rectangle rC = { chefao.x - 25, chefao.y - 25, 50, 50 };
                    Rectangle rJ = { jogador.x, jogador.y, 40, 40 };

                    if (CheckCollisionRecs(rJ, rC) && chefaoTimer <= 0.0f)
                    {
                        vida       -= 10;
                        chefaoTimer = 0.5f;
                        if (vida <= 0) { vida = 0; estadoAtual = GAME_OVER; }
                    }
                }

                // --- Chefoes extras ---
                for (int i = 0; i < quantidadeChefoes; i++)
                {
                    if (!chefaoExtraAtivo[i]) continue;
                    float velE  = velChefao * 0.85f;
                    Vector2 novaE = chefoes[i];

                    if (chefoes[i].x < centroJogador.x) novaE.x += velE;
                    if (chefoes[i].x > centroJogador.x) novaE.x -= velE;
                    if (chefoes[i].y < centroJogador.y) novaE.y += velE;
                    if (chefoes[i].y > centroJogador.y) novaE.y -= velE;

                    novaE      = ResolverColisaoPilar(novaE, 21, pilares, MAX_PILARES);
                    chefoes[i] = novaE;

                    chefaoExtraTimer[i] -= dt;
                    Rectangle rE = { chefoes[i].x - 20, chefoes[i].y - 20, 40, 40 };
                    Rectangle rJ = { jogador.x, jogador.y, 40, 40 };

                    if (CheckCollisionRecs(rJ, rE) && chefaoExtraTimer[i] <= 0.0f)
                    {
                        vida -= 8;
                        chefaoExtraTimer[i] = 0.5f;
                        if (vida <= 0) { vida = 0; estadoAtual = GAME_OVER; }
                    }
                }

                // --- Colisao jogador x mini fantasma ---
                for (int i = 0; i < numFantasmasOnda; i++)
                {
                    if (!fantasmaAtivo[i]) continue;
                    Rectangle rJ = { jogador.x, jogador.y, 40, 40 };
                    Rectangle rF = { fantasmas[i].x - 12, fantasmas[i].y - 12, 24, 24 };

                    if (CheckCollisionRecs(rJ, rF))
                    {
                        fantasmaAtivo[i] = false;
                        pontuacao       += 10;
                        fantasmasCpt    += 1;

                        if (!plasmaCarregado)
                        {
                            plasmaCarga++;
                            if (plasmaCarga >= PLASMA_CARGA_MAX) plasmaCarregado = true;
                        }

                        if (pontuacao % 100 == 0 && quantidadeChefoes < MAX_CHEFOES)
                        {
                            float sx = (centroJogador.x < LARGURA_TELA / 2)
                                       ? (float)GetRandomValue(500, 750)
                                       : (float)GetRandomValue(50, 300);
                            float sy = (centroJogador.y < ALTURA_TELA / 2)
                                       ? (float)GetRandomValue(350, 470)
                                       : (float)GetRandomValue(AREA_Y_MIN + 30, 200);

                            chefoes[quantidadeChefoes]           = (Vector2){ sx, sy };
                            chefaoExtraAtivo[quantidadeChefoes]  = true;
                            chefaoExtraVida[quantidadeChefoes]   = CHEFAO_VIDA_MAX;
                            chefaoExtraTimer[quantidadeChefoes]  = 0.0f;
                            quantidadeChefoes++;
                        }
                    }
                }

                // --- Nova onda ---
                bool todosMortos = true;
                for (int i = 0; i < numFantasmasOnda; i++)
                    if (fantasmaAtivo[i]) { todosMortos = false; break; }

                if (todosMortos)
                {
                    onda++;
                    numFantasmasOnda = MAX_FANTASMAS_BASE + (onda - 1) * 2;
                    if (numFantasmasOnda > MAX_FANTASMAS) numFantasmasOnda = MAX_FANTASMAS;

                    velocidadeFantasma = 2.2f + (float)(onda - 1) * 0.15f;

                    for (int i = 0; i < numFantasmasOnda; i++)
                    {
                        fantasmaAtivo[i] = true;
                        do {
                            fantasmas[i].x = (float)GetRandomValue(50, 750);
                            fantasmas[i].y = (float)GetRandomValue(AREA_Y_MIN + 30, ALTURA_TELA - 50);
                        } while (
                            fabsf(fantasmas[i].x - centroJogador.x) < 100 &&
                            fabsf(fantasmas[i].y - centroJogador.y) < 100
                        );
                    }
                }

                // --- WIN ---
                if (!chefaoAtivo && quantidadeChefoes > 0)
                {
                    bool todosExtrasMortos = true;
                    for (int i = 0; i < quantidadeChefoes; i++)
                        if (chefaoExtraAtivo[i]) { todosExtrasMortos = false; break; }
                    if (todosExtrasMortos) estadoAtual = WIN;
                }

                if (IsKeyPressed(KEY_G)) estadoAtual = GAME_OVER;

            } // fim do else (nao pausado)

